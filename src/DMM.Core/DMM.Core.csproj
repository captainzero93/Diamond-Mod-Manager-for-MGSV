  <ItemGroup>
    <!-- built in; a file of the same name next to the program replaces it -->
    <EmbeddedResource Include="..\..\data\qar_dictionary.txt" LogicalName="qar_dictionary.txt" />
    <EmbeddedResource Include="..\..\data\fpk_dictionary.txt" LogicalName="fpk_dictionary.txt" />
  </ItemGroup>
</Project>
