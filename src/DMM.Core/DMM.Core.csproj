    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DMM.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BuildMarker" Value="DMM_V0_9_86" />
